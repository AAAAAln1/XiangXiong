{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Powershell(*)",
      "Agent",
      "Task",
      "WebSearch",
      "Read(*)",
      "Grep(*)",
      "Write(*)",
      "Glob(*)",
      "WebFetch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/memory_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/inline_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/ask_user_denied.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/session_start.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
