# secrets / local env
.benchmark.json
*.ovpn
*.log
cookies.txt
.env
.env.*

# host credentials — NEVER commit (was untracked but not ignored: `git add -A` would have leaked it)
.ssh/

# one-off hook probe config (not product surface; nothing references it)
.claude/settings.testhook.json

# local research scratch dumps (not product surface; contains local paths & target refs)
scratch/

# python / test cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# artifacts — never publish target evidence
results/

# local benchmark instances (their nested results/ are ignored by the rule above;
# ignore the whole tree so `git add -A` cannot pick up local state)
instances/

# internal design/audit docs (may contain real target refs; not public surface)
docs/

# active world / local runtime state
.claude/memory.md
.claude/memory.md.*
.claude/settings.local.json
.observe_state.json
.observe_state.json.*
.turn_state.json
.turn_state.json.*

# debug / scratch
.dbg/
*_tmp_*
scripts/_tmp_*
*-local-command-caveat*
*.tmp

# archives / dumps at repo root
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ad-hoc local notes / score dumps (not product)
跑分.txt
jyt_poc_*
resultsbench_list.json
benchmark-*.txt

# dependency trees accidentally under tree
**/node_modules/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# agent working memory (host-side; not product surface)
.workbuddy/

# local / process notes (not product surface)
象雄完整工作原理与文件作用说明.md

# research scratch (keep local; product narrative lives in README / ARCHITECTURE)
# 只忽略仓库根目录的 experiments/；tests/phase0/fixture/experiments 是必需 fixture
/experiments/

# local benchmark and test utilities (keep local; not part of public surface)
runtime/benchmark_*.py
runtime/test_*.py

# local session analysis / scratch debug (keep local; contain local paths & target refs)
/analyze_sessions.py
/recount_delta.py
/test_compile.py
/test_experiments.py

# curl `-o <path>` first-wins 残留：调用方把 -o 写在固定参数前时，
# 其 -o 不生效且会在 cwd 落一个字面名为 -o 的响应文件（历史事故 2026-09-23）
/-o
/-O
